# Server
PORT=4000
HOST=0.0.0.0
NODE_ENV=development

# Security
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=7d

# Storage
DB_PATH=./data/xeere.db

# CORS (comma separated origins, or * for all)
CORS_ORIGIN=*

# Firebase / Google auth (optional). Minimum required: the project ID.
# Set FIREBASE_SERVICE_ACCOUNT (JSON string) or GOOGLE_APPLICATION_CREDENTIALS
# (path) only if you need admin SDK operations.
FIREBASE_PROJECT_ID=
